rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['uid', 'email', 'role']);
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Properties Collection (Public Read, Owner/Admin Write)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(propertyId);
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      // Guests can read their own bookings, hosts can read bookings for their property, or public lookup with valid ID
      allow read: if true;
      allow create: if isValidId(bookingId) && 
        request.resource.data.keys().hasAll(['id', 'propertyId', 'selectedDate', 'totalLkr', 'status']);
      allow update: if isSignedIn() || (
        request.resource.data.id == resource.data.id &&
        request.resource.data.propertyId == resource.data.propertyId
      );
      allow delete: if false;
    }

    // Statutory Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
